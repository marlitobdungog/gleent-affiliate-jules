# Application settings
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_PORT=8089
APP_URL=http://localhost:8089
FRONTEND_URL=http://localhost:8089

# VM Compose database settings
DB_PASSWORD=replace-with-database-password
MYSQL_ROOT_PASSWORD=replace-with-mysql-root-password

# Auth service credentials. Set these for the target environment.
AUTH_SERVICE_INTERNAL_API_KEY=
AUTH_SERVICE_AFFILIATE_CLIENT_ID=
AUTH_SERVICE_AFFILIATE_CLIENT_SECRET=
AUTH_SERVICE_AFFILIATE_ONBOARDING_CLIENT_ID=
AUTH_SERVICE_AFFILIATE_ONBOARDING_CLIENT_SECRET=

# Auth service configuration
AUTH_SERVICE_URL=https://auth.gleent.com
AUTH_SERVICE_BROWSER_URL=https://auth.gleent.com
AUTH_SERVICE_AFFILIATE_CALLBACK_URL=http://localhost:8089/api/sso/callback
AUTH_SERVICE_AFFILIATE_APPLICATION_CODE=gleent-affiliate
AUTH_SERVICE_AFFILIATE_ONBOARDING_APPLICATION_CODE=affiliate-onboarding
AUTH_SERVICE_TENANT_SLUG=gleent
AUTH_SERVICE_CONNECT_TIMEOUT_SECONDS=3
AUTH_SERVICE_TIMEOUT_SECONDS=10

# Cookie settings for the VM-hosted web app
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8089,127.0.0.1,127.0.0.1:8089
